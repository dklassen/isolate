{{/* Edit this template, not assets/ulogd.conf; regenerate with: go generate . */ -}}
# Code generated by `isolate generate` from assets/ulogd.conf.tmpl; DO NOT EDIT.
#
# Writes the packets entrypoint.sh's egress firewall drops (NFLOG group 1)
# as one JSON object per line. Plugins are autoloaded from ulogd's plugin
# directory, so no per-architecture plugin= paths are needed.
[global]
logfile="{{.LogDir}}/ulogd.log"
loglevel=3
stack=log1:NFLOG,base1:BASE,ifi1:IFINDEX,ip2str1:IP2STR,json1:JSON

[log1]
group=1

[json1]
file="{{.LogDir}}/firewall.json"
sync=1
