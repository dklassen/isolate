# Copy this file to secrets.env and fill in real values. Passed through to
# the container via `container run --env-file` (see --secrets-file in
# run.go) -- not agent-specific, not parsed by isolate itself, just
# key=value lines. claude authenticates via an interactive `/login` at
# startup instead of an API key (see README), so GH_TOKEN is the only
# entry needed here today.
GH_TOKEN=ghp_...
